<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.fund.FundDetailsFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/fund_details_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        style="@style/ApnaFund.Toolbar"
        android:title="@string/text_fund_deposits"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIconTint="@color/black"
        app:titleTextColor="@color/white" />

    <TextView
        android:id="@+id/text_view_fund_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:padding="12dp"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textStyle="italic|bold"
        app:layout_constraintTop_toBottomOf="@id/fund_details_toolbar"
        tools:text="My Fund" />

    <HorizontalScrollView
        android:id="@+id/scrollview_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text_view_fund_name">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TableLayout
                android:id="@+id/table_fund_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:padding="10dp"
                android:stretchColumns="*">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="@string/text_serial_number"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:gravity="center_vertical|center_horizontal"
                        android:padding="3dp"
                        android:text="@string/text_member"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:ellipsize="none"
                        android:gravity="center_vertical|center_horizontal"
                        android:maxLines="2"
                        android:padding="3dp"
                        android:text="@string/text_total_deposited_amount"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:ellipsize="none"
                        android:gravity="center_vertical|center_horizontal"
                        android:maxLines="2"
                        android:padding="3dp"
                        android:text="@string/text_total_loan_amount"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="110dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:ellipsize="none"
                        android:gravity="center_vertical|center_horizontal"
                        android:maxLines="2"
                        android:padding="3dp"
                        android:text="@string/text_total_pending_amount"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="110dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:ellipsize="none"
                        android:gravity="center_vertical|center_horizontal"
                        android:maxLines="2"
                        android:padding="3dp"
                        android:text="@string/text_total_interest_paid"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:ellipsize="none"
                        android:gravity="center_vertical|center_horizontal"
                        android:maxLines="2"
                        android:padding="3dp"
                        android:text="@string/text_expected_maturity_amount"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="@string/text_apply_loan"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </TableRow>
            </TableLayout>
        </LinearLayout>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>