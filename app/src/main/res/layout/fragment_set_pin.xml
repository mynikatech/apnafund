<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/set_pin_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:id="@+id/logoImageView"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_apnafund_logo" />

    <TextView
        android:id="@+id/text_enter_pin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:text="Enter 4-digit PIN"
        android:textSize="20sp" />

    <LinearLayout
        android:id="@+id/entry_pin_boxes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/entry_pin_digit_1"
            style="@style/PinBoxStyle" />

        <EditText
            android:id="@+id/entry_pin_digit_2"
            style="@style/PinBoxStyle" />

        <EditText
            android:id="@+id/entry_pin_digit_3"
            style="@style/PinBoxStyle" />

        <EditText
            android:id="@+id/entry_pin_digit_4"
            style="@style/PinBoxStyle" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_confirm_pin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:text="Confirm PIN"
        android:textSize="20sp" />

    <LinearLayout
        android:id="@+id/confirm_pin_boxes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/confirm_pin_digit_1"
            style="@style/PinBoxStyle" />

        <EditText
            android:id="@+id/confirm_pin_digit_2"
            style="@style/PinBoxStyle" />

        <EditText
            android:id="@+id/confirm_pin_digit_3"
            style="@style/PinBoxStyle" />

        <EditText
            android:id="@+id/confirm_pin_digit_4"
            style="@style/PinBoxStyle" />
    </LinearLayout>
    <!-- Buttons -->
    <LinearLayout
        app:layout_constraintTop_toBottomOf="@id/moderatorFieldsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_submit"
            style="@style/ApnaFundButton.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Submit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel"
            style="@style/ApnaFundButton.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel" />
    </LinearLayout>
</LinearLayout>