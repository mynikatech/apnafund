<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="?android:attr/windowBackground"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Welcome message -->
            <TextView
                android:id="@+id/text_view_welcome_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/text_welcome_user"
                android:textColor="@color/text_heading"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/noGroupMessageContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textViewNoGroupMessage"
                    style="@style/TextViewAppearance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/message_no_assigned_group" />

                <ImageView
                    android:id="@+id/button_add_group_none"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/text_add_group"
                    android:focusable="true"
                    android:src="@drawable/icon_add" />

                <TextView
                    android:id="@+id/textViewAddGroupMessageNone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/header_add_group"
                    android:textStyle="italic" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/GroupMessageContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="4dp">
                <!-- Group chip -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_group_name"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/header_group"
                        app:chipIcon="@drawable/ic_group" />

                    <LinearLayout
                        android:id="@+id/layout_add_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="2dp">

                        <ImageView
                            android:id="@+id/button_add_group"
                            style="@style/AppIcon"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/header_add_group"
                            android:focusable="true"
                            android:src="@drawable/icon_add" />

                        <TextView
                            android:id="@+id/textViewAddGroupMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/header_add_group"
                            android:textStyle="italic" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/FundMessageContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="4dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="12dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/fundSelectorContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="0dp">

                            <!-- Clickable Fund Display -->
                            <LinearLayout
                                android:id="@+id/layout_fund_selector"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:clickable="true"
                                android:focusable="true"
                                android:orientation="horizontal"
                                android:padding="4dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <!-- Fund Name -->
                                <TextView
                                    android:id="@+id/textViewSelectedFund"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_select_fund"
                                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

                                <!-- Status Dot -->
                                <ImageView
                                    android:id="@+id/imageFundStatus"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginStart="6dp"
                                    android:contentDescription="@string/text_fund_status"
                                    android:src="@drawable/status_active_dot" />

                                <!-- Dropdown Arrow -->
                                <ImageView
                                    android:id="@+id/imageDropdownArrow"
                                    style="@style/AppIcon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginStart="6dp"
                                    android:contentDescription="@string/text_dropdown_arrow"
                                    android:src="@drawable/ic_arrow_drop_down" />
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </LinearLayout>
                    <!-- Fund Deposit Summary -->
                    <TextView
                        android:id="@+id/text_view_fund_summary_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="4dp"
                        android:textSize="14sp"
                        tools:text="Total Deposit: ₹4000  |  Maturity Amount: ₹20000" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="4dp">

                        <TextView
                            android:id="@+id/text_view_fund_moderator_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/text_moderator"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_view_fund_moderator_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:textSize="12sp"
                            android:textStyle="italic"
                            tools:text="Moderator Name" />
                    </LinearLayout>
                    <!-- Fund Details as collapsible section-->

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp">

                        <TextView
                            android:id="@+id/text_view_fund_details_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:paddingEnd="2dp"
                            android:text="@string/text_view_details"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="italic"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/image_fund_Expand_Collapse"
                            style="@style/AppIcon"
                            android:contentDescription="@string/expand_or_collapse"
                            android:src="@drawable/ic_down_arrow"
                            app:layout_constraintBottom_toBottomOf="@+id/text_view_fund_details_header"
                            app:layout_constraintStart_toEndOf="@+id/text_view_fund_details_header"
                            app:layout_constraintTop_toTopOf="@+id/text_view_fund_details_header" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:id="@+id/line_fund_details"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="@android:color/darker_gray"
                        android:visibility="gone" />
                    <!-- Grid-like Info Section -->
                    <LinearLayout
                        android:id="@+id/fund_details_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:columnCount="2"
                            android:rowCount="8">

                            <TextView
                                android:id="@+id/label_start_date"
                                style="@style/FundLabel"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                android:text="@string/text_fund_start_date" />

                            <TextView
                                android:id="@+id/label_maturity_date"
                                style="@style/FundLabel"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                android:text="@string/text_fund_maturity_date" />

                            <TextView
                                android:id="@+id/text_view_start_date_value"
                                style="@style/FundValue"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                tools:text="02/05/2025" />

                            <TextView
                                android:id="@+id/text_view_fund_maturity_date"
                                style="@style/FundValue"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                tools:text="02/05/2027" />

                            <!-- Column 3: Frequency -->
                            <TextView
                                android:id="@+id/label_frequency"
                                style="@style/FundLabel"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                android:text="@string/text_frequency" />

                            <TextView
                                android:id="@+id/label_period"
                                style="@style/FundLabel"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                android:text="@string/text_period" />

                            <TextView
                                android:id="@+id/text_view_frequency_value"
                                style="@style/FundValue"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                tools:text="Monthly" />

                            <TextView
                                android:id="@+id/text_view_fund_period_value"
                                style="@style/FundValue"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                tools:text="24 Months" />

                        </GridLayout>

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:columnCount="2"
                            android:rowCount="4">

                            <TextView
                                style="@style/FundLabel"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                android:text="@string/text_monthly_contribution" />

                            <TextView
                                android:id="@+id/text_view_fund_dep_amount_value"
                                style="@style/FundValue"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                tools:text="2000" />

                            <TextView
                                style="@style/FundLabel"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                android:text="@string/text_total_expected_deposit" />

                            <TextView
                                android:id="@+id/text_view_fund_tot_exp_dep_amount_value"
                                style="@style/FundValue"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                tools:text="20000" />

                            <TextView
                                style="@style/FundLabel"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                android:text="@string/text_total_current_deposit" />

                            <TextView
                                android:id="@+id/text_view_fund_tot_curr_dep_amount_value"
                                style="@style/FundValue"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                tools:text="12000" />

                            <TextView
                                style="@style/FundLabel"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                android:text="@string/text_total_expected_maturity" />

                            <TextView
                                android:id="@+id/text_view_fund_tot_exp_mat_amount_value"
                                style="@style/FundValue"
                                android:layout_width="0dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                tools:text="22000" />
                        </GridLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/view_user_deposits"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="2dp"
                                android:paddingEnd="16dp"
                                android:text="@string/text_view_fund_deposits"
                                android:textAppearance="?attr/textAppearanceBody2"
                                android:textColor="@color/link_colour" />

                            <TextView
                                android:id="@+id/view_fund_summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_detailed_fund_summary"
                                android:textAlignment="textEnd"
                                android:textAppearance="?attr/textAppearanceBody2"
                                android:textColor="@color/link_colour" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider for Loans -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.8dp"
                        android:layout_marginVertical="8dp"
                        android:background="@android:color/darker_gray" />
                    <!-- Loan List goes here -->
                    <TextView
                        android:id="@+id/text_view_loans_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:paddingBottom="4dp"
                        android:text="@string/text_loan"
                        android:textColor="@color/blue_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/loansContentContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycler_view_loans"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/item_loan" />

                        <TextView
                            android:id="@+id/text_view_no_loans"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="4dp"
                            android:text="@string/text_no_loan_message"
                            android:textColor="@color/purple"
                            android:textSize="14sp"
                            android:visibility="gone" />

                    </LinearLayout>
                    <!-- Apply loan button -->
                    <LinearLayout
                        android:id="@+id/loan_add_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginTop="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/loan_add_fab"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_margin="4dp"

                            android:focusable="true"
                            android:padding="0dp"
                            android:src="@drawable/icon_loan"
                            app:maxImageSize="20dp" />

                        <TextView
                            android:id="@+id/loan_add_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/text_apply_new_loan"
                            android:textSize="14sp"
                            android:textStyle="italic|bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/noFundsMessageContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textViewNoFundMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/message_text_no_funds"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/loadingFunds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </LinearLayout>


        </LinearLayout>

    </ScrollView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_assistant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:iconTint="?attr/colorOnPrimary"
        android:elevation="4dp"
        android:translationZ="4dp"
        android:src="@drawable/ic_chat_help"
        app:iconGravity="textStart"
        app:iconPadding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>