<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.admin.user.UserFragment">

    <HorizontalScrollView
        android:id="@+id/scrollview_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TableLayout
                android:id="@+id/table_user_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/table_header_bg">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="@string/text_serial_no"
                        android:textColor="@color/table_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="160dp"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="@string/label_user_name"
                        android:textColor="@color/table_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="160dp"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="@string/text_email"
                        android:textColor="@color/table_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="@string/text_phone_number"
                        android:textColor="@color/table_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="140dp"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="@string/header_single_group"
                        android:textColor="@color/table_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="48dp"
                        android:maxWidth="48dp"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="@string/text_edit"
                        android:textColor="@color/table_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="54dp"
                        android:maxWidth="48dp"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="@string/text_status"
                        android:textColor="@color/table_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </TableRow>
            </TableLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerUsers"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scrollbars="vertical"/>
        </LinearLayout>
    </HorizontalScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/text_add_user"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        android:id="@+id/fab"
        android:src="@drawable/icon_add"/>
</androidx.constraintlayout.widget.ConstraintLayout>