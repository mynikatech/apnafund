<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ApnaFundCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- HEADER -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/text_view_fund_name_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/header_view_fund_name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/text_view_fund_status_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/text_view_fund_status_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/text_active"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/text_view_fund_name_value"
                app:layout_constraintEnd_toStartOf="@id/image_menu"
                app:layout_constraintTop_toTopOf="@id/text_view_fund_name_value" />

            <ImageButton
                android:id="@+id/image_menu"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more_vert"
                app:layout_constraintBottom_toBottomOf="@id/text_view_fund_name_value"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/text_view_fund_name_value"
                app:tint="?attr/colorOnSurface" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 🔹 COMPACT SUMMARY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <TextView
                android:id="@+id/text_amount_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹2000/month"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/text_date_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01 Apr 2026 • 31 Mar 2028"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_quick_actions_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <!-- LEFT: Actions -->
            <LinearLayout
                android:id="@+id/layout_quick_actions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/imageExpandCollapseFund"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/text_view_fund_member_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:paddingStart="1dp"
                    android:paddingEnd="12dp"
                    android:text="@string/text_view_fund_members"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/text_view_fund_loans_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/text_view_loans"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- RIGHT: Expand arrow -->
            <ImageView
                android:id="@+id/imageExpandCollapseFund"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/expand_or_collapse"
                android:src="@drawable/ic_down_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/colorOnSurfaceVariant" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 🔹 EXPANDED SECTION -->
        <LinearLayout
            android:id="@+id/fund_details_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="2dp"
                android:background="?attr/colorOutline" />

            <!-- Moderator + Links -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_moderator"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_view_fund_moderator_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <!-- 🔹 SUMMARY GRID -->
            <GridLayout
                android:id="@+id/grid_fund_summ_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:columnCount="2">

                <!-- Period -->
                <TextView
                    style="@style/FundLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:text="@string/text_fund_period"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_view_fund_period_value"
                    style="@style/FundValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:textSize="11sp" />

                <!-- Frequency -->
                <TextView
                    style="@style/FundLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginTop="2dp"
                    android:text="@string/text_frequency"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_view_fund_frequency_value"
                    style="@style/FundValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp" />
            </GridLayout>
            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="6dp"
                android:background="?attr/colorOutline" />

            <!-- 🔹 DEPOSIT GRID -->
            <GridLayout
                android:id="@+id/grid_fund_dep_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2">

                <!-- Total Expected -->
                <TextView
                    style="@style/FundLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:text="@string/text_total_expected_deposit"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_view_fund_total_expected_value"
                    style="@style/FundValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp" />

                <!-- Current Deposit -->
                <TextView
                    style="@style/FundLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginTop="2dp"
                    android:text="@string/text_total_current_deposit"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_view_fund_total_current_value"
                    style="@style/FundValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp" />

                <!-- Maturity Amount -->
                <TextView
                    style="@style/FundLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginTop="2dp"
                    android:text="@string/text_total_expected_maturity"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_view_fund_maturity_amount_value"
                    style="@style/FundValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp" />

                <TextView
                    style="@style/FundLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginTop="2dp"
                    android:text="@string/header_single_group"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/text_view_fund_group_value"
                    style="@style/FundValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginTop="2dp"
                    android:background="?attr/selectableItemBackground"
                    android:textColor="@color/link_colour"
                    android:textSize="11sp"
                    tools:text="My Fund" />


            </GridLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>