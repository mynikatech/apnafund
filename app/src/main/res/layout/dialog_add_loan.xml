<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <TextView
        android:id="@+id/text_view_fund_available_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingStart="4dp"
        android:text="Available Amount: ₹4000"
        android:textSize="14sp"
        android:textStyle="bold|italic"
        app:layout_constraintTop_toTopOf="parent"/>
    <!-- Borrower Name (disabled, auto-filled) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_borrower"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text_view_fund_available_value">

        <AutoCompleteTextView
            android:id="@+id/edit_text_borrower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/text_borrower"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Loan Amount -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_loan_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text_input_borrower">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_loan_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/text_amount"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Issue Date -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_issue_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text_input_loan_amount"
        android:layout_marginTop="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_issue_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/text_issue_date"
            android:focusable="false"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Period (months) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text_input_issue_date"
        android:layout_marginTop="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/text_period_months"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Rate of Interest -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_rate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text_input_period"
        android:layout_marginTop="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/text_rate_of_interest"
            android:enabled="false" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Save Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/text_input_rate">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save_loan"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="Save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_loan"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="Cancel" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
