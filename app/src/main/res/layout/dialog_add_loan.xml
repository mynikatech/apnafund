<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/layout_amounts_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total: ₹4000"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/text_available"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Available: ₹3000"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/text_approved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Approved: ₹500"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/text_pending"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pending: ₹500"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>
    <!-- Borrower Name (disabled, auto-filled) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_borrower"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/layout_amounts_container">

        <AutoCompleteTextView
            android:id="@+id/edit_text_borrower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="@string/text_borrower"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Loan Amount -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_loan_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text_input_borrower">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_loan_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/text_amount"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Issue Date -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_issue_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text_input_loan_amount"
        android:layout_marginTop="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_issue_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/text_issue_date"
            android:focusable="false"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Period (months) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text_input_issue_date"
        android:layout_marginTop="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/text_period_months"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Rate of Interest -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_rate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text_input_period"
        android:layout_marginTop="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/text_rate_of_interest"
            android:enabled="false" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Save Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/text_input_rate">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save_loan"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/text_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_loan"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/text_cancel_button" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
