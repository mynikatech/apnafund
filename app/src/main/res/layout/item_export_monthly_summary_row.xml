<?xml version="1.0" encoding="utf-8"?>

<TableRow
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/textMemberName" />

    <TextView
        android:id="@+id/textDeposit"
        android:gravity="end" />

    <TextView
        android:id="@+id/textLoan"
        android:gravity="end" />

    <TextView
        android:id="@+id/textPrepayment"
        android:gravity="end" />

    <TextView
        android:id="@+id/textInterest"
        android:gravity="end" />

    <TextView
        android:id="@+id/textFees"
        android:gravity="end" />

</TableRow>