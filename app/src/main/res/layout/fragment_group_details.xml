<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.member.GroupDetailsFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/group_details_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        style="@style/ApnaFund.Toolbar"
        android:title="@string/text_group_members"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/text_view_group_name_value"
        tools:text="Jai MataDi Society"
        android:textStyle="bold|italic"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        app:layout_constraintTop_toBottomOf="@id/group_details_toolbar"
        android:layout_margin="10dp"/>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/text_view_moderator"
        android:text="@string/label_primary_moderator_tilda"
        android:textStyle="italic"
        android:textSize="16sp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/purple"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_view_group_name_value"
        android:layout_margin="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/text_view_moderator_value"
        tools:text="Sunil Agarwal"
        android:textStyle="italic"
        android:textSize="16sp"
        android:fontFamily="sans-serif-black"
        app:layout_constraintStart_toEndOf="@id/text_view_moderator"
        app:layout_constraintTop_toBottomOf="@id/text_view_group_name_value"
        android:layout_margin="10dp"/>


    <HorizontalScrollView
        android:id="@+id/scrollview_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        app:layout_constraintTop_toBottomOf="@id/text_view_moderator">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TableLayout
                android:id="@+id/table_group_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:padding="10dp"
                android:stretchColumns="*">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="@string/text_serial_no"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="@string/header_member_name"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="@string/text_joining_date"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="Role"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="Status"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="Action"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_shape"
                        android:gravity="center_vertical"
                        android:padding="3dp"
                        android:text="Edit"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </TableRow>
            </TableLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/text_add_group_member"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        android:id="@+id/group_details_fab"
        android:src="@drawable/icon_add"/>
</androidx.constraintlayout.widget.ConstraintLayout>