<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.ApnaFund" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorTertiary">#FDD835</item> <!-- Amber -->
        <!-- Background -->
        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>

        <!-- Primary -->
        <item name="colorPrimary">@color/blue_light</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
    <style name="CustomTextAppearance" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">?attr/android:textColorPrimary</item>
    </style>
    <style name="TabLayoutTextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/android:textColorPrimary</item>
    </style>
    <style name="TextViewAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorSurface</item>
    </style>
    <style name="ApnaFundCard" >
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>
    <style name="PinBoxStyle">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:inputType">numberPassword</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">24sp</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">?attr/android:textColorPrimary</item>
        <item name="android:background">@drawable/pin_box_bg</item>
    </style>

    <style name="SideMenuDialogTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowEnterAnimation">@anim/slide_in_left</item>
        <item name="android:windowExitAnimation">@anim/slide_out_left</item>
        <item name="android:textAppearanceMedium">@style/CustomTextAppearance</item>
    </style>

    <style name="FundLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#1E88E5</item>
        <item name="android:textSize">13sp</item>
        <item name="fontFamily">sans-serif-black</item>
        <item name="android:paddingStart">4dp</item>
    </style>
    <style name="FundValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>

    <style name="Theme.ApnaFund.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="Theme.ApnaFund" parent="Base.Theme.ApnaFund" />
</resources>