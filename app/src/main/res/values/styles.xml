<resources>

    <!-- PRIMARY BUTTON -->
    <style name="ApnaFundButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/btn_primary_text_selector</item>
        <item name="backgroundTint">@color/btn_primary_bg_selector</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- SECONDARY BUTTON -->
    <style name="ApnaFundButton.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/btn_secondary_text</item>
        <item name="strokeColor">@color/btn_secondary_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/btn_secondary_bg</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ApnaFund.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="navigationIconTint">?attr/colorOnPrimary</item>

        <item name="android:elevation">4dp</item>

    </style>

</resources>